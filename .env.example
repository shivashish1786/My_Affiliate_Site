# Copy this file to .env.local for local development.
# On Vercel: Project -> Settings -> Environment Variables (add the same names).

# --- Site identity (public) ---
NEXT_PUBLIC_SITE_NAME="BookNook Summaries"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_AUTHOR_NAME="Your Name"
NEXT_PUBLIC_CONTACT_EMAIL="you@example.com"

# --- Amazon Associates (public) ---
# Your Associate Tracking ID. India example: yourname-21
NEXT_PUBLIC_AMAZON_TAG="yourname-21"
# Marketplace you are approved for: www.amazon.in, www.amazon.com, www.amazon.co.uk ...
NEXT_PUBLIC_AMAZON_DOMAIN="www.amazon.in"

# --- Form emails via Resend (https://resend.com) - server only, never NEXT_PUBLIC ---
RESEND_API_KEY=""
# Where contact / promo form messages are delivered
CONTACT_TO_EMAIL="you@example.com"
# Verified sender (use onboarding@resend.dev while testing)
CONTACT_FROM_EMAIL="onboarding@resend.dev"
